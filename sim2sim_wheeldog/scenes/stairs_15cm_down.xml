<mujoco model="wheeldog stairs 15cm down">
  <!-- 15cm 下楼梯，踏面 0.31m，宽 2.4m，平台高 0.75m 后 5 级下降 -->
  <include file="../wheeldog.xml"/>

  <statistic center="1.89 0 0.60" extent="4.0"/>

  <visual>
    <global azimuth="120" elevation="-20" offwidth="1280" offheight="720"/>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.75 0.75 0.75" specular="0.15 0.15 0.15"/>
    <rgba haze="0.15 0.25 0.35 1"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
      rgb1="0.22 0.28 0.32" rgb2="0.14 0.18 0.22" markrgb="0.8 0.8 0.8"
      width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="8 8" reflectance="0.2"/>
    <material name="stairs" rgba="0.55 0.58 0.62 1"/>
  </asset>

  <worldbody>
    <light pos="2 2 5" dir="-0.2 -0.2 -1" directional="true"/>
    <geom name="floor" type="plane" size="25 25 0.05" material="groundplane" friction="1.5 0.1 0.01"/>
    <geom name="dn15_platform" type="box" pos="0.3850 0 0.3750" size="0.6150 1.2000 0.3750" material="stairs" friction="1.5 0.1 0.01"/>
    <geom name="dn15_step_1" type="box" pos="1.1550 0 0.3000" size="0.1550 1.2000 0.3000" material="stairs" friction="1.5 0.1 0.01"/>
    <geom name="dn15_step_2" type="box" pos="1.4650 0 0.2250" size="0.1550 1.2000 0.2250" material="stairs" friction="1.5 0.1 0.01"/>
    <geom name="dn15_step_3" type="box" pos="1.7750 0 0.1500" size="0.1550 1.2000 0.1500" material="stairs" friction="1.5 0.1 0.01"/>
    <geom name="dn15_step_4" type="box" pos="2.0850 0 0.0750" size="0.1550 1.2000 0.0750" material="stairs" friction="1.5 0.1 0.01"/>
  </worldbody>

  <!-- override spawn: free(7) + 内八 joints -->
  <keyframe>
    <key name="spawn" qpos="0.3850 0.0000 1.2000 1 0 0 0
      -0.15 0.35 0.70 0
      0.15 -0.35 -0.70 0
      0.15 -0.35 -0.70 0
      -0.15 0.35 0.70 0"/>
  </keyframe>
</mujoco>
